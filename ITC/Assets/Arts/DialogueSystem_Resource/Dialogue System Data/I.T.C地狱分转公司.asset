    - title: Appearance
      value: "\u7EC5\u58EB\u98CE\u5EA6\uFF0C\u5F6C\u5F6C\u6709\u793C\uFF0C\u6148\u7965\u6E29\u67D4\u3002"
      type: 0
      typeString: 
    - title: Sex_04
      value: 1
      type: 1
      typeString: CustomFieldType_Number
    - title: Sex_05
      value: 0
      type: 1
      typeString: CustomFieldType_Number
    - title: Sex_13
      value: 3
      type: 1
      typeString: CustomFieldType_Number
    - title: LargeTextValue
      value: "\u6570\u5343\u5E74\u6765\u4ED6\u4E00\u76F4\u90FD\u662FHenet\u6700\u5F97\u529B\u7684\u52A9\u624B\uFF0C\u6216\u7740\u8BF4\u662F\u548C\u5979\u6700\u4EB2\u8FD1\u7684\u4EBA\u3002Henet\u559C\u6B22\u5230\u5904\u4F7F\u5524\u8FD9\u4E2A\u9AB7\u9AC5\u4F8D\u4ECE\uFF0C\u800COld
        Tom\u4ECE\u6765\u90FD\u662F\u6BEB\u65E0\u6028\u8A00\u3002"
      type: 0
      typeString: 
    - title: SmallTextValue_03
      value: 
      type: 0
      typeString: 
    - title: SmallTextValue_06
      value: "\u4E00\u4E32\u5730\u72F1\u94A5\u5319\u3002\u8BB0\u5F55Henet\u6210\u957F\u7684\u65E5\u8BB0\u672C\u3002"
      type: 0
      typeString: 
    - title: SmallTextValue_07
      value: "Henet\u3002ITC\u7684\u5458\u5DE5\u4EEC\u3002"
      type: 0
      typeString: 
    - title: SmallTextValue_09
      value: 195cm
      type: 0
      typeString: 
    - title: LargeTextValue_02
      value: "\u4F5C\u4E3AHenet\u7684\u8D34\u8EAB\u4F8D\u4ECE\uFF0C\u4ED6\u5728Henet\u521A\u51FA\u751F\u65F6\u5C31\u88AB\u5B89\u6392\u5728\u5979\u7684\u8EAB\u8FB9\uFF0C\u6709\u4E00\u6B21\uFF0C\u5C0FHenet\u4ECE\u4EBA\u95F4\u5077\u6765\u4E86\u4E00\u53EA\u5C0F\u7F8A\u7F94\uFF0C\u628A\u5B83\u5F53\u73A9\u5076\u4E00\u6837\u62B1\u7740\u5F88\u662F\u5F00\u5FC3\uFF0C\u7A81\u7136\u51B2\u51FA\u51E0\u53EA\u6076\u9B54\u628AHenet\u5728\u4EBA\u95F4\u5077\u6765\u7684\u5C0F\u7F8A\u7F94\u5206\u98DF\u4E86\u8FD8\u628A\u5979\u8E29\u5728\u811A\u4E0B\u8E22\u6253\u5979\uFF0C\u8FD9\u65F6\u4F8D\u4ECE\u4ECE\u80CC\u540E\u62CE\u8D77\u51E0\u4E2A\u6076\u9B54\u628A\u4ED6\u4EEC\u6253\u7684\u8FDE\u6492\u65E6\u90FD\u4E0D\u8BA4\u4E0D\u51FA\u6765\uFF0C\u4ED6\u5B89\u6170\u7740\u5C0FHenet\u522B\u54ED\uFF0C\u65E0\u8BBA\u5979\u5230\u54EA\u91CC\u81EA\u5DF1\u90FD\u4F1A\u8DDF\u7740\u5979\u4FDD\u62A4\u5979\u7684\uFF0C\u8BF4\u7740\u628AHenet\u80CC\u5230\u8116\u5B50\u4E0A\u56DE\u5730\u72F1\u4E86\uFF0C\u4ECE\u6B64\uFF0CHenet\u65E0\u8BBA\u53BB\u5230\u54EA\u91CC\u90FD\u4F1A\u5E26\u4E0A\u4ED6\uFF0C\u5373\u4F7F\u73B0\u5728\u5979\u5DF2\u7ECF\u4E0D\u9700\u8981\u4ED6\u7684\u4FDD\u62A4\u3002\u5728\u6570\u4E2A\u5343\u5E74\u540E\uFF0C\u4E3A\u4E86\u5B8C\u6210\u6492\u65E6\u5B9A\u4E0B\u7684\u6307\u6807\uFF0CHenet\u53C8\u5E26\u7740\u4ED6\u7684\u4F8D\u4ECE\u6765\u5230\u4E86\u4EBA\u95F4\uFF0C\u4F46\u8FD9\u6B21\u4ED6\u6709\u4E86\u540D\u5B57-Old
        Tom\u867D\u7136\u8FD9\u4E2A\u540D\u5B57\u662FHenet\u968F\u4FBF\u7ED9\u4ED6\u53D6\u7684\uFF0C\u4F46\u4F60\u4EFB\u7136\u53EF\u4EE5\u4ECE\u90A3\u5F20\u6BEB\u65E0\u8868\u60C5\u7684\u9AB7\u9AC5\u8138\u4E0A\u770B\u51FA\u4E00\u79CD\u6148\u7231\u3002"
      type: 0
      typeString: 
    - title: LargeTextValue_03
      value: "\u4ECD\u7136\u65F6\u523B\u5728Henet\u8EAB\u8FB9\u5B88\u62A4Henet\uFF0C\u542C\u4ECEHenet\u7684\u6307\u4F7F\u3002"
      type: 0
      typeString: 
    - title: MediumTextValue
      value: "\u8EAB\u6750\u9AD8\u5927\uFF0C\u9AB7\u9AC5\u5F62\u6001\uFF0C\u5934\u9876\u9AA8\u5934\u6709\u7F3A\u53E3\u3002\u773C\u578B\u4E0B\u5782\uFF0C\u5DE6\u773C\u4E0A\u6709\u88C2\u7F1D\u3002\u53CC\u624B\u4E60\u60EF\u80CC\u5728\u8EAB\u540E\u3002"
      type: 0
      typeString: 
    - title: MediumTextValue_02
      value: "\u6C38\u8FDC\u5B88\u62A4\u5728Henet\u8EAB\u8FB9\uFF0C\u786E\u4FDDITC\u7684\u6B63\u5E38\u8FD0\u8F6C\u3002\u7EF4\u62A4\u516C\u53F8\u7684\u58F0\u8A89\u3002\u57F9\u517B\u65B0\u4E00\u4EE3\u4F18\u79C0\u5458\u5DE5\u3002\u89C1\u8BC1Henet\u7684\u6BCF\u4E00\u6B65\u6210\u529F\u3002"
      type: 0
      typeString: 
    - title: MediumTextValue_03
      value: "\u770B\u7740Henet\u4E8B\u4E1A\u6709\u6210\u3002\u4EE5\u7EC5\u58EB\u65B9\u5F0F\u5904\u7406\u95EE\u9898\u3002\u7167\u987E\u516C\u53F8\u7684\u6BCF\u4E2A\u5458\u5DE5\u3002"
      type: 0
      typeString: 
    - title: MediumTextValue_04
      value: "\u4EFB\u4F55\u5A01\u80C1\u5230Henet\u7684\u4E8B\u7269\u3002\u5BF9Henet\u4E0D\u656C\u7684\u8A00\u8BBA\u3002\u7834\u574F\u516C\u53F8\u79E9\u5E8F\u7684\u4EBA\u3002\u4E0D\u73CD\u60DC\u673A\u4F1A\u7684\u5458\u5DE5\u3002"
      type: 0
      typeString: 
    - title: MediumTextValue_05
      value: "\u4EFB\u4F55\u4F24\u5BB3\u6216\u80CC\u53DBHenet\u7684\u884C\u4E3A\u3002\u8D28\u7591\u4ED6\u5BF9Henet\u7684\u5FE0\u8BDA\u3002\u5BF9Henet\u7684\u8FC7\u53BB\u5984\u52A0\u8BC4\u8BBA\u3002\u4E0D\u5C0A\u91CD\u516C\u53F8\u79E9\u5E8F\u3002\u8F9C\u8D1FHenet\u7ED9\u4E88\u7684\u673A\u4F1A\u3002"
      type: 0
      typeString: 
