      type: 0
      typeString: 
    - title: Appearance
      value: "\u80C6\u5C0F\u61E6\u5F31\uFF0C\u5355\u7EAF\u5584\u826F\uFF0C\u6709\u4E00\u5B9A\u7684\u5DE5\u4F5C\u80FD\u529B\u4F46\u7F3A\u4E4F\u81EA\u4FE1"
