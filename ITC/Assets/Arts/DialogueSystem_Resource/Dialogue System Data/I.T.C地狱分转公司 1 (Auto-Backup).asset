    - title: SmallTextValue_09
      value: 164
      type: 0
      typeString: 
    - title: LargeTextValue_02
      value: "\u88AB\u5377\u5165\u4E00\u573A\u9634\u8C0B\uFF0C\u66FF\u4EBA\u9876\u7F6A\uFF0C\u5728\u7761\u68A6\u4E2D\u88AB\u4EBA\u7528\u9EBB\u888B\u5957\u4F4F\u5934\u52D2\u6B7B\u3002\u5C5E\u4E8E\u5DF2\u6B7B\u4E4B\u4EBA\uFF0C\u4F46\u662F\u6CA1\u6709\u6210\u4E3A\u7075\u9B42\u8FDB\u5165\u5929\u5802\u6216\u5730\u72F1\uFF0C\u6210\u4E3A\u65E0\u9B42\u8005\uFF0C\u5931\u53BB\u4E86\u751F\u524D\u7684\u8BB0\u5FC6\uFF0C\u4F46\u540C\u65F6\u4FDD\u7559\u5F3A\u5927\u7684\u6267\u5FF5\u3002"
      type: 0
      typeString: 
    - title: LargeTextValue_03
      value: "\u901A\u8FC7\u4ECB\u7ECD\u6765\u5230\u4E86ITC\u5723\u7EBD\u7EA6\u5BA2\u5206\u516C\u53F8\uFF0C\u6210\u4E3A\u4E86\u7B7E\u7EA6\u7A97\u53E3\u7684\u8BD5\u5DE5\u671F\u6587\u5458\u3002\u572813\u5929\u7684\u6E38\u620F\u65F6\u95F4\u91CC\u9700\u8981\u52AA\u529B\u5B8C\u6210\u5DE5\u4F5C\u6307\u6807\uFF0C\u987A\u5229\u664B\u5347\u4E3A\u6B63\u5F0F\u5458\u5DE5\u3002"
      type: 0
      typeString: 
    - title: MediumTextValue
      value: "\u5934\u4E0A\u5957\u7740\u7528\u9EBB\u7EF3\u6346\u7ED1\u4F4F\u7684\u5E03\u888B\n\u8EAB\u4F53\u5173\u8282\u5904\u6253\u4E0A\u4E86\u7ED3\u6784\u94A2\u9489\n\u5E73\u65F6\u7A7F\u7740\u516C\u53F8\u5458\u5DE5\u670D\u88C5"
      type: 0
      typeString: 
    - title: MediumTextValue_02
      value: "\u5B8C\u6210\u8BD5\u7528\u671F\u5DE5\u4F5C\u5185\u5BB9\uFF0C\u987A\u5229\u5165\u804CITC\u5723\u7EBD\u7EA6\u5BA2\u5206\u516C\u53F8"
      type: 0
