    - title: LargeTextValue
      value: "\u539F\u672C\u662F\u5723\u7EBD\u7EA6\u5BA2\u5E02\u6C11\uFF08\u4EBA\u7C7B\uFF09\uFF0C\u88AB\u5728\u7761\u68A6\u4E2D\u95F7\u6B7B\u3002\u5728\u7A92\u606F\u7684\u7761\u68A6\u4E2D\u9192\u6765\u5230\u4E86\u5730\u72F1\uFF0C\u540E\u7EED\u7531\u4EE5\u65E0\u9B42\u8005\u7684\u8EAB\u4EFD\u91CD\u65B0\u56DE\u5230\u5723\u7EBD\u7EA6\u5BA2\u3002\u901A\u8FC7\u4ECB\u7ECD\u6765\u5230\u4E86ITC\u5723\u7EBD\u7EA6\u5BA2\u5206\u516C\u53F8\uFF0C\u6210\u4E3A\u7B7E\u7EA6\u7A97\u53E3\u7684\u8BD5\u5DE5\u671F\u6587\u5458\u3002"
      type: 0
      typeString: 
    - title: SmallTextValue_03
      value: 
      type: 0
